rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /evidence/{uid}/{file} {
      allow write: if request.auth != null && request.auth.uid == uid && resource == null;
      allow read: if request.auth != null && (request.auth.uid == uid || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'faculty');
    }
    match /{path=**} { allow read, write: if false; }
  }
}